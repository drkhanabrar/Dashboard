name: MirrorForge CI
on:
  push:
    branches: [main, develop]
  pull_request:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  verify:
    runs-on: ubuntu-24.04
    steps:
      - name: Checkout
        uses: actions/checkout@v4
      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 22
      - name: Install
        run: npm install
      - name: Syntax checks
        run: |
          node --check apps/server/src/server.cjs
          node --check apps/license-api/src/server.cjs
          node --check desktop/main.cjs
          node --check apps/server/public/app.js
          node --check apps/server/public/display.js
          node --check apps/mobile/www/mobile.js
      - name: Test
        run: npm test
