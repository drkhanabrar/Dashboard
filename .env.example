# Main dashboard server
HOST=0.0.0.0
PORT=4173
# Path for the app's data and uploaded photos. Defaults to a platform-appropriate user-data folder.
DATA_DIR=
# Used only when running the separate licensing issuer service.
LICENSE_API_HOST=127.0.0.1
LICENSE_API_PORT=4180
LICENSE_PRIVATE_KEY_FILE=./secrets/license-private.pem
LICENSE_DB_FILE=./apps/license-api/data/licenses.sqlite
LICENSE_ADMIN_TOKEN=replace-this-with-a-long-random-secret
# Server URL the app should contact for commercial activation. The bundled public key is used to verify signed licenses.
LICENSE_API_URL=http://127.0.0.1:4180
# Optional Cloudflare Tunnel / reverse-proxy URL can point to the main app server.
